# Local development defaults. Copied to .env by `make env`; never commit .env.

COMPOSE_PROJECT_NAME=aml

# Core banking source database (CDC origin)
SOURCE_DB_USER=corebanking
SOURCE_DB_PASSWORD=corebanking-local
SOURCE_DB_NAME=corebanking
# Role Debezium logs in with: replication and read access to the captured tables only
CDC_DB_USER=debezium
CDC_DB_PASSWORD=debezium-local
# Read-only role the lakehouse reconciles the core banking with, without access to identities
RECONCILIATION_DB_USER=reconciliation
RECONCILIATION_DB_PASSWORD=reconciliation-local

# Platform metadata database (Nessie, Airflow)
PLATFORM_DB_SUPERUSER_PASSWORD=platform-local
NESSIE_DB_PASSWORD=nessie-local
AIRFLOW_DB_PASSWORD=airflow-local

# Airflow: encryption key of stored connections, and the secret signing task tokens
AIRFLOW_FERNET_KEY=IISgBqqsTruzFdEekzMWxklbzb-2iuhUJAxiu2Aawo0=
AIRFLOW_JWT_SECRET=fmBRuQ2DFSIx60PJGuLA-Y2jDnUKxwpS0WPRteDgHQs

# Trino HTTPS listener for reporting tools: keystore, node secret, and the passwords of the people
# who log in (Power BI connects as bi)
TRINO_KEYSTORE_PASSWORD=trino-keystore-local
TRINO_SHARED_SECRET=trino-shared-secret-local-0123456789
TRINO_BI_PASSWORD=bi-local
TRINO_COMPLIANCE_PASSWORD=compliance-local
TRINO_ANALYST_PASSWORD=analyst-local

# S3-compatible object storage
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=lakehouse-local-secret
S3_REGION=us-east-1
S3_BUCKET=lakehouse
